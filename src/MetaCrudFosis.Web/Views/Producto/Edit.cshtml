@model Producto
@{
    ViewData["Title"] = "Editar producto";
}

<div class="card">
    <h1>Editar producto</h1>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre"></span>
        </div>
        <div class="form-group">
            <label asp-for="Precio"></label>
            <input asp-for="Precio" type="number" step="0.01" />
            <span asp-validation-for="Precio"></span>
        </div>
        <div class="form-group">
            <label asp-for="Stock"></label>
            <input asp-for="Stock" type="number" />
            <span asp-validation-for="Stock"></span>
        </div>
        <div class="form-group">
            <label asp-for="FechaAlta"></label>
            <input asp-for="FechaAlta" />
            <span asp-validation-for="FechaAlta"></span>
        </div>

        <div class="actions-row">
            <button type="submit" class="btn">Actualizar</button>
            <a class="btn btn-secondary" href="/Producto">Cancelar</a>
        </div>
    </form>
</div>